# Google AI Studio (https://aistudio.google.com/apikey) で発行した Gemini APIキー
GEMINI_API_KEY=
# 使うモデル (省略時 gemini-3.5-flash)。使えるモデル名は Google AI Studio で確認できます
GEMINI_MODEL=gemini-3.5-flash
# 管理者画面のパスワード (必ず変更してください)
ADMIN_PASSWORD=change-me
PORT=3000
# 1日のGemini呼び出し回数の上限(費用対策)
DAILY_AI_CALL_LIMIT=3000
# (公開時) 無料のSupabaseにデータを保存する場合。supabase.sql を先に実行してください
SUPABASE_URL=
SUPABASE_SECRET_KEY=
